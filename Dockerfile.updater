FROM node:24.18.0-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @emu/server build

FROM node:24.18.0-slim
WORKDIR /updater
COPY --from=build /app/packages/server/dist/updater.js ./updater.js
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:3400/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "updater.js"]
